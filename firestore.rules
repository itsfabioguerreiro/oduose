rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Troque o texto abaixo pelo UID da sua conta de dono (ver LEIA-ME, passo 8)
    function dono() {
      return request.auth != null && request.auth.uid == 'vFEWlhJapSfCTJzoGtSf00mlpwk1';
    }

    // Cada cliente só vê e altera os seus próprios dados
    match /clientes/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || dono());
    }

    // Pedidos: o cliente cria e vê os seus; o dono vê todos e muda o estado
    match /pedidos/{id} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.estado == 'Novo';
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || dono());
      allow update, delete: if dono();
    }
  }
}
